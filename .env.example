# =============================================================================
# CollabWrite - Environment Configuration Example
# Copy to .env and adjust. Never commit a real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Origins allowed to call the API and open a WebSocket. Comma-separated for
# several. This is an allowlist: there is no '*' fallback, because a
# permissive origin combined with credentials would let any site drive the
# API with a victim's session.
CLIENT_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops to trust for the client IP. 0 (the default) is
# correct when Node is reached directly. Set 1 behind exactly one proxy --
# nginx in Docker Compose, or the platform router on Render. Left at 0 behind a
# proxy, every request appears to come from the proxy and rate limiting buckets
# all users into a single counter; set too high, a client can spoof
# X-Forwarded-For and side-step the limiter.
TRUST_PROXY=0

# Base URL the React client calls, baked into the bundle at BUILD time.
# Empty means same-origin relative URLs, which is what you want whenever a
# proxy (nginx, or a CDN host rewriting /api) sits in front of both. Set it to
# the absolute backend URL only when the client is served from a different
# origin, e.g. a Vercel deployment calling a Render backend.
VITE_API_URL=

# -----------------------------------------------------------------------------
# PostgreSQL - SUPPORT DATA ONLY
#
# Users, authentication metadata, document metadata, permissions and audit
# logs. No document content, versions, locks or indexes (rules.md section 8).
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collabwrite
DB_USER=collabuser
DB_PASSWORD=collabpassword
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# 'postgres' (default) or 'memory'. The in-memory store lets the engine and
# the API run without a database; it is the default under NODE_ENV=test.
STORE_DRIVER=postgres

# -----------------------------------------------------------------------------
# Authentication
#
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=replace_this_with_a_long_random_value_before_any_shared_deployment
# There is no refresh-token flow (see docs/security/security-architecture.md
# section 6), so this is the hard limit on a session. 15m suits development;
# raise it for a demo or a user is signed out mid-session with no way back.
JWT_EXPIRATION=15m
BCRYPT_ROUNDS=10

# Requests per window, per IP. Set generously for a classroom demo.
AUTH_RATE_LIMIT=50
API_RATE_LIMIT=600

# =============================================================================
# ACADEMIC ENGINE
# Every value below maps to a decision recorded in design.md.
# =============================================================================

# Directory holding documents.dat, wal.log, index.dat and metrics.log.
# Defaults to ./data when unset.
ENGINE_DATA_DIR=./data

# Buffer pool frames (design.md section 4). Small values make page faults and
# LRU eviction easy to observe during the demo; raise for real workloads.
ENGINE_BUFFER_FRAMES=8

# Worker pool size: the ceiling on concurrently running transactions
# (design.md section 8).
ENGINE_WORKERS=4

# Scheduling policy: FIFO or ROUND_ROBIN. Switchable at runtime through
# POST /api/admin/scheduler/policy.
SCHEDULER_POLICY=FIFO

# Lock request timeout in milliseconds; 0 disables it and relies purely on
# deadlock detection (design.md section 7).
LOCK_TIMEOUT_MS=5000

# Wait-for graph sweep interval in milliseconds. Lower detects deadlock
# faster and costs more CPU.
DEADLOCK_CHECK_INTERVAL_MS=250

# Maximum keys per B+-Tree node before a split (design.md section 11).
ENGINE_INDEX_ORDER=4

# fsync the WAL on COMMIT. 'false' is much faster and gives up durability
# against a machine crash; only ever set it false in tests.
WAL_SYNC_ON_COMMIT=true

# Write performance samples to metrics.log (design.md section 16).
ENABLE_METRICS=true
