# =============================================================================
# CollabWrite - Environment Configuration Example
# Copy this file to .env and configure values for your environment
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Client Configuration
CLIENT_ORIGIN=http://localhost:3000
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_WS_URL=http://localhost:3001

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collabwrite
DB_USER=collabuser
DB_PASSWORD=collabpassword
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Redis Configuration (Pub/Sub & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Tokens
JWT_SECRET=collabwrite_jwt_access_secret_production_key_must_be_long_and_random
JWT_REFRESH_SECRET=collabwrite_jwt_refresh_secret_production_key_must_be_long_and_random
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Concurrency & Lock Management
LOCK_TIMEOUT_SECONDS=30
DEADLOCK_CHECK_INTERVAL_MS=5000
MAX_CONCURRENT_USERS_PER_DOC=100

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090
